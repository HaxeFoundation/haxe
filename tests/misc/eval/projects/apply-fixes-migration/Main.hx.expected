import p.Things;
import p.Bar;
import p.High;

enum E {
	Foo;
}

class Foo {
	public static var v = 1;
}

class Main {
	static function f(_:Int, ?a:Int) {
		return a;
	}

	static function g(_:String, y:Int, x:String) {
		return x;
	}

	static function main() {
		var a = E.Foo;
		var b = Foo.v + Bar.v;
		var c = Kind.Bar;
		var d = Level.High;
		var e:Kind = Bar;
		trace(a, b, c, d, e, f(1, 2), g("a", 0, "b"));
