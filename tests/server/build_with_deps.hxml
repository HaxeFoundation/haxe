-p src
-cp ../display/src-shared
-cp ../../haxeserver/git/src
-cp ../../haxeserver/git/shared
--main Main
-js test.js
-lib hxnodejs
-lib utest
-lib hxcoro
-lib hxparse
-lib haxeparser
-lib tokentree
-lib formatter
-lib rename
-lib json2object
-lib language-server-protocol
-lib vscode-json-rpc
-lib safety
-D analyzer-optimize
-D UTEST-PRINT-TESTS
-D UTEST_FAILURE_THROW
