# A macro reads a define whose value changes.
=== initial
@args -D level=1
@expect-output level 1
--- Main.hx
class Main {
	static function main() {
		trace("level " + Macro.level());
	}
}
--- Macro.hx
class Macro {
	public static macro function level() {
		return macro $v{haxe.macro.Context.definedValue("level")};
	}
}

=== define value changes
@args -D level=2
@expect-output level 2
