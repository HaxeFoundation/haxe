# An initialization macro generates types on demand through onTypeNotFound.
@args --macro Gen.init()
@known-failure types generated by onTypeNotFound are not regenerated when the initialization macro changes
=== initial
@expect-output Foo
--- Main.hx
class Main {
	static function main() {
		trace(Auto_Foo.name());
	}
}
--- Gen.hx
import haxe.macro.Context;

class Gen {
	public static function init() {
		Context.onTypeNotFound(function(path:String) {
			if (!StringTools.startsWith(path, "Auto_")) return null;
			var name = path.substr(5);
			var td = macro class Dummy {
				public static function name() return $v{name};
			};
			td.name = path;
			return td;
		});
	}
}

=== another generated type is used
@expect-output Foo Bar
--- Main.hx
class Main {
	static function main() {
		trace(Auto_Foo.name() + " " + Auto_Bar.name());
	}
}

=== generator changes
@expect-output gen:Foo gen:Bar
--- Gen.hx
import haxe.macro.Context;

class Gen {
	public static function init() {
		Context.onTypeNotFound(function(path:String) {
			if (!StringTools.startsWith(path, "Auto_")) return null;
			var name = "gen:" + path.substr(5);
			var td = macro class Dummy {
				public static function name() return $v{name};
			};
			td.name = path;
			return td;
		});
	}
}
