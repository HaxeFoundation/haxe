# A build macro records classes in a registry, reported by an onAfterTyping
# callback. A @:persistent registry kept the entries of classes that are no
# longer compiled; a haxe.macro.TypeCache gives the types of the compilation
# (plan phase 7, item 5).
@args --macro Macro.init()
=== initial
@expect-compiler-output registry: A
--- Main.hx
class Main {
	static function main() {
		A.touch();
	}
}
--- Registered.hx
@:autoBuild(Macro.register())
interface Registered {}
--- A.hx
class A implements Registered {
	public static function touch() {}
}
--- Macro.hx
import haxe.macro.Context;
import haxe.macro.TypeCache;

class Macro {
	static var seen = new TypeCache<String>();

	public static function init() {
		Context.onAfterTyping(function(_) {
			Sys.println("registry: " + [for (e in seen.all()) e.value].join(","));
		});
	}

	public static function register():Array<haxe.macro.Expr.Field> {
		seen.setCurrent(Context.getLocalClass().get().name);
		return null;
	}
}

=== class B added and used
@expect-compiler-output registry: A,B
--- B.hx
class B implements Registered {
	public static function touch() {}
}
--- Main.hx
class Main {
	static function main() {
		A.touch();
		B.touch();
	}
}

=== class B removed
@expect-compiler-output registry: A
--- delete B.hx
--- Main.hx
class Main {
	static function main() {
		A.touch();
	}
}
