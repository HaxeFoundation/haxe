# An initialization macro gives a configuration to the build macros that run
# after it: what it leaves in the static variables, writes in place (a map)
# included, is their base, which every expansion starts from (plan phase 7,
# item 4). The changes an expansion makes are undone when it ends, in place
# too: A and B each see the configuration only, whatever the order of their
# builds and the domain running them.
@args --macro Macro.init()
=== ordinary statics
@expect-no-warning
@expect-output prefix: my, names: 1, seen: 1 | prefix: my, names: 1, seen: 1
--- Main.hx
class Main {
	static function main() {
		trace(A.info() + " | " + B.info());
	}
}
--- A.hx
@:build(Macro.build())
class A {}
--- B.hx
@:build(Macro.build())
class B {}
--- Macro.hx
class Macro {
	static var prefix:String = null;
	static var names = new Map<String, Bool>();
	static var seen:Array<String> = [];

	public static function init() {
		prefix = "my";
		names.set("a", true);
	}

	public static function build():Array<haxe.macro.Expr.Field> {
		var fields = haxe.macro.Context.getBuildFields();
		seen.push(haxe.macro.Context.getLocalClass().toString());
		var s = "prefix: " + prefix + ", names: " + [for (k in names.keys()) k].length + ", seen: " + seen.length;
		names.set("b", true);
		prefix = "changed";
		fields.push((macro class {
			public static function info() return $v{s};
		}).fields[0]);
		return fields;
	}
}

=== persistent statics
@expect-no-warning
@expect-output prefix: my, names: 1, seen: 1 | prefix: my, names: 1, seen: 1
--- Macro.hx
class Macro {
	@:persistent static var prefix:String = null;
	@:persistent static var names = new Map<String, Bool>();
	static var seen:Array<String> = [];

	public static function init() {
		prefix = "my";
		names.set("a", true);
	}

	public static function build():Array<haxe.macro.Expr.Field> {
		var fields = haxe.macro.Context.getBuildFields();
		seen.push(haxe.macro.Context.getLocalClass().toString());
		var s = "prefix: " + prefix + ", names: " + [for (k in names.keys()) k].length + ", seen: " + seen.length;
		fields.push((macro class {
			public static function info() return $v{s};
		}).fields[0]);
		return fields;
	}
}
