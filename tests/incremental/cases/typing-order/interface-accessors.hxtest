# The accessors generated for the properties of an interface are placed right
# after their property, whatever the order in which the fields are typed.
@targets js
@shuffle-seeds 1 2 3 4 5 6 7 8

=== initial
@expect-output a,get_a,set_a,b,get_b,c,set_c
--- Main.hx
class Main {
	static function main() {
		trace(Fields.of(I).join(","));
	}
}
--- Fields.hx
import haxe.macro.Context;

class Fields {
	public static macro function of(e:haxe.macro.Expr) {
		return switch (Context.getType(haxe.macro.ExprTools.toString(e))) {
			case TInst(c, _):
				macro $v{[for (f in c.get().fields.get()) f.name]};
			case _:
				throw "class expected";
		}
	}
}
--- I.hx
interface I {
	var a(get, set):Int;
	var b(get, never):Int;
	var c(never, set):Int;
}
