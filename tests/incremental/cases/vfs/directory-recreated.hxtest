# A directory that the server watches is deleted and created again: changes
# in the new directory are still seen.
@known-failure [watch] a directory created again after its deletion is not watched again
@args -cp src
@main Main
=== initial
@expect-output v1
@expect-no-fs-calls
--- src/Main.hx
class Main {
	static function main() {
		trace(pack.Foo.get());
	}
}
--- src/pack/Foo.hx
package pack;

class Foo {
	public static function get() return "v1";
}

=== directory deleted and created again
@expect-output v2
--- delete-dir src/pack
--- src/pack/Foo.hx
package pack;

class Foo {
	public static function get() return "v2";
}

=== file edited in the new directory
@expect-output v3
--- src/pack/Foo.hx
package pack;

class Foo {
	public static function get() return "v3";
}
