# Two edits of the same file within one second. The server compares
# modification times with a one second precision (`sys_filetime`,
# libs/extc/extc_stubs.c), so the second edit is not detected.
@real-mtime
@known-failure modification times are compared with a one second precision
=== initial
@expect-output value 1
--- Main.hx
class Main {
	static function main() {
		trace("value " + Dep.get());
	}
}
--- Dep.hx
class Dep {
	public static function get() return 1;
}

=== edit right after the previous compilation
@expect-output value 2
--- Dep.hx
class Dep {
	public static function get() return 2;
}

=== and again
@expect-output value 3
--- Dep.hx
class Dep {
	public static function get() return 3;
}
