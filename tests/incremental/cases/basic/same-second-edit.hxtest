# Two edits of the same file within one second: the second edit gets a
# modification time a fraction of a second after the first one. The server
# must see it (modification times have a full precision, `sys_filetime` in
# libs/extc/extc_stubs.c).
=== initial
@expect-output value 1
--- Main.hx
class Main {
	static function main() {
		trace("value " + Dep.get());
	}
}
--- Dep.hx
class Dep {
	public static function get() return 1;
}

=== edit
@expect-output value 2
--- Dep.hx
class Dep {
	public static function get() return 2;
}

=== edit again within the same second
@same-second
@expect-output value 3
--- Dep.hx
class Dep {
	public static function get() return 3;
}
