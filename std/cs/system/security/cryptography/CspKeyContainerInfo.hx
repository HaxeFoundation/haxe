package cs.system.security.cryptography;

/** Provides additional information about a cryptographic key pair. This class cannot be inherited. */
@:native("System.Security.Cryptography.CspKeyContainerInfo")
extern class CspKeyContainerInfo {
	/**
	 * Gets a value indicating whether a key in a key container is accessible.
	 * @return if the key is accessible; otherwise, .
	 */
	var Accessible(default, never):Bool;
	/**
	 * Gets a value indicating whether a key can be exported from a key container.
	 * @return if the key can be exported; otherwise, .
	 */
	var Exportable(default, never):Bool;
	/**
	 * Gets a value indicating whether a key is a hardware key.
	 * @return if the key is a hardware key; otherwise, .
	 */
	var HardwareDevice(default, never):Bool;
	/**
	 * Gets a key container name.
	 * @return The key container name.
	 */
	var KeyContainerName(default, never):String;
	/**
	 * Gets a value that describes whether an asymmetric key was created as a signature
	 * key or an exchange key.
	 * @return One of the  values that describes whether an asymmetric key was created
	 * as a signature key or an exchange key.
	 */
	var KeyNumber(default, never):cs.system.security.cryptography.KeyNumber;
	/**
	 * Gets a value indicating whether a key is from a machine key set.
	 * @return if the key is from the machine key set; otherwise, .
	 */
	var MachineKeyStore(default, never):Bool;
	/**
	 * Gets a value indicating whether a key pair is protected.
	 * @return if the key pair is protected; otherwise, .
	 */
	var Protected(default, never):Bool;
	/**
	 * Gets the provider name of a key.
	 * @return The provider name.
	 */
	var ProviderName(default, never):String;
	/**
	 * Gets the provider type of a key.
	 * @return The provider type. The default is 1.
	 */
	var ProviderType(default, never):Int;
	/**
	 * Gets a value indicating whether a key container was randomly generated by a
	 * managed cryptography class.
	 * @return if the key container was randomly generated; otherwise, .
	 */
	var RandomlyGenerated(default, never):Bool;
	/**
	 * Gets a value indicating whether a key can be removed from a key container.
	 * @return if the key is removable; otherwise, .
	 */
	var Removable(default, never):Bool;
	/**
	 * Gets a unique key container name.
	 * @return The unique key container name.
	 */
	var UniqueKeyContainerName(default, never):String;
	function new(parameters:cs.system.security.cryptography.CspParameters):Void;
}
