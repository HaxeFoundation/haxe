package cs.system.xml.serialization;

/** Signifies that the code was generated by the serialization infrastructure and can be reused for increased performance, when this attribute is applied to an assembly. */
@:native("System.Xml.Serialization.XmlSerializerVersionAttribute")
extern class XmlSerializerVersionAttribute extends cs.system.Attribute {
	/**
	 * Gets or sets the common language runtime (CLR) namespace of the assembly.
	 * @return A  containing the common language runtime (CLR) namespace of the
	 * assembly.
	 */
	var Namespace(default, default):String;
	/**
	 * Gets or sets the identity of the parent assembly.
	 * @return The version of the parent assembly.
	 */
	var ParentAssemblyId(default, default):String;
	/**
	 * Gets or sets the type that the serializer operates on.
	 * @return The  to be serialized.
	 */
	var Type(default, default):cs.system.Type;
	/**
	 * Gets or sets the assembly's version number.
	 * @return The version of the assembly.
	 */
	var Version(default, default):String;
	@:overload(function():Void {})
	function new(type:cs.system.Type):Void;
}
