package cs.system.xml.serialization;

/** Maintains a group of names for related code entities or type mappings that are generated by the .NET Framework's XML serialization infrastructure. */
@:native("System.Xml.Serialization.CodeIdentifiers")
extern class CodeIdentifiers {
	/**
	 * Gets or sets a value that indicates whether the instance uses camel case.
	 * @return to indicate that the instance uses camel case;  to indicate that the
	 * instance uses Pascal case.
	 */
	var UseCamelCasing(default, default):Bool;
	@:overload(function():Void {})
	function new(caseSensitive:Bool):Void;
	/**
	 * Adds a named code entity or type mapping to the  instance's scope.
	 * @param identifier A name that is used to index the code entity.
	 * @param value The code entity or type mapping information.
	 */
	function Add(identifier:String, value:Dynamic):Void;
	/**
	 * Prevents a specified name from being used within the  instance's scope.
	 * @param identifier A name that will not be available within the  instance's
	 * scope.
	 */
	function AddReserved(identifier:String):Void;
	/**
	 * Adds a named code entity or type mapping to the  instance's scope, ensuring that
	 * the name is unique within the scope.
	 * @param identifier A candidate name that is used to index the code entity.
	 * @param value The code entity or type mapping information.
	 * @return The identifier parameter value or a modified string if there is a name
	 * collision.
	 */
	function AddUnique(identifier:String, value:Dynamic):String;
	/** Removes all code entities or type mappings, including their names, from the  instance's scope. */
	function Clear():Void;
	/**
	 * Determines whether a specified name is already being used within the  instance's
	 * scope.
	 * @param identifier The name to check for use within the  instance's scope.
	 * @return if the name is already in use; otherwise, .
	 */
	function IsInUse(identifier:String):Bool;
	/**
	 * Ensures that the input is of the correct case by modifying the name according to
	 * the value of the  property.
	 * @param identifier The name to possibly modify.
	 * @return A string that is the same as the input identifier or has the first
	 * letter's case modified.
	 */
	function MakeRightCase(identifier:String):String;
	/**
	 * Determines whether the input name conflicts with another name within the 
	 * instance's scope and, if it does, generates a modified string.
	 * @param identifier The name to modify if it is not already unique.
	 * @return The identifier parameter value or a modified string if there is a name
	 * collision.
	 */
	function MakeUnique(identifier:String):String;
	/**
	 * Removes from the  instance's scope the code entity or type mapping identified by
	 * the input name.
	 * @param identifier The name of the code entity or type mapping information to
	 * remove.
	 */
	function Remove(identifier:String):Void;
	/**
	 * Removes the input name from the  instance's reserved names.
	 * @param identifier A name that will be made available within the  instance's
	 * scope.
	 */
	function RemoveReserved(identifier:String):Void;
	/**
	 * Returns an array of the code entities or type mappings within the  instance's
	 * scope.
	 * @param type The type of all the code entities or type mappings for the instance.
	 * @return An array of the code entities or type mappings that is stored by the 
	 * object.
	 */
	function ToArray(type:cs.system.Type):Dynamic;
}
