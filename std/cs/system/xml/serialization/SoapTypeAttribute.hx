package cs.system.xml.serialization;

/** Controls the schema generated by the  when a class instance is serialized as SOAP encoded XML. */
@:native("System.Xml.Serialization.SoapTypeAttribute")
extern class SoapTypeAttribute extends cs.system.Attribute {
	/**
	 * Gets or sets a value that indicates whether to include the type in SOAP-encoded
	 * XML Schema documents.
	 * @return to include the type in SOAP-encoded XML Schema documents; otherwise, .
	 * The default is .
	 */
	var IncludeInSchema(default, default):Bool;
	/**
	 * Gets or sets the namespace of the XML type.
	 * @return The namespace of the XML type. The default is an empty string ("").
	 */
	var Namespace(default, default):String;
	/**
	 * Gets or sets the name of the XML type.
	 * @return The name of the XML type. The default is the class name.
	 */
	var TypeName(default, default):String;
	@:overload(function():Void {})
	@:overload(function(typeName:String):Void {})
	function new(typeName:String, ns:String):Void;
}
