package cs.system.runtime.compilerservices;

/** Controls the strictness of the code generated by the common language runtime's just-in-time (JIT) compiler. */
@:native("System.Runtime.CompilerServices.CompilationRelaxationsAttribute")
extern class CompilationRelaxationsAttribute extends cs.system.Attribute {
	/**
	 * Gets the compilation relaxations specified when the current object was
	 * constructed.
	 * @return The compilation relaxations specified when the current object was
	 * constructed. Use the  enumeration with the  property.
	 */
	var CompilationRelaxations(default, never):Int;
	@:overload(function(relaxations:Int):Void {})
	function new(relaxations:cs.system.runtime.compilerservices.CompilationRelaxations):Void;
}
