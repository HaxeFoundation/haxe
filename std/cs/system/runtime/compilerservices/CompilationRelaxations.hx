package cs.system.runtime.compilerservices;

/** Specifies parameters that control the strictness of the code generated by the common language runtime's just-in-time (JIT) compiler. */
@:native("System.Runtime.CompilerServices.CompilationRelaxations")
extern enum abstract CompilationRelaxations(Int) {
	var NoStringInterning = 8;
	@:op(A | B) static function or(lhs:CompilationRelaxations, rhs:CompilationRelaxations):CompilationRelaxations;
	@:op(A & B) static function and(lhs:CompilationRelaxations, rhs:CompilationRelaxations):CompilationRelaxations;
	@:op(A ^ B) static function xor(lhs:CompilationRelaxations, rhs:CompilationRelaxations):CompilationRelaxations;
	@:op(~A) static function complement(value:CompilationRelaxations):CompilationRelaxations;
}
