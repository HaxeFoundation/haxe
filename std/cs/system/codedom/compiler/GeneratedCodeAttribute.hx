package cs.system.codedom.compiler;

/** Identifies code generated by a tool. This class cannot be inherited. */
@:native("System.CodeDom.Compiler.GeneratedCodeAttribute")
extern class GeneratedCodeAttribute extends cs.system.Attribute {
	/**
	 * Gets the name of the tool that generated the code.
	 * @return The name of the tool that generated to code.
	 */
	var Tool(default, never):String;
	/**
	 * Gets the version of the tool that generated the code.
	 * @return The version of the tool that generated the code.
	 */
	var Version(default, never):String;
	function new(tool:String, version:String):Void;
}
