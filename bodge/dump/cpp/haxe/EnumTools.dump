	{
		cf_name = createByIndex;
		cf_doc = 
		Creates an instance of enum `e` by calling its constructor number
		`index` with arguments `params`.

		The constructor indices are preserved from Haxe syntax, so the first
		declared is index 0, the next index 1 etc.

		If `e` or `index` is `null`, or if enum `e` has no constructor
		corresponding to index `index`, or if the number of elements in `params`
		does not match the expected number of constructor arguments, or if any
		argument has an invalid type, the result is unspecified.
	;
		cf_type = TFun([e:TAbstract(Enum, [TInst(createByIndex.T, [])]), index:TAbstract(Int, []), ?params:TAbstract(Null, [TInst(Array, [TDynamic])])], TInst(createByIndex.T, []));
		cf_pos = /usr/local/share/haxe/std/haxe/EnumTools.hx: 3034-3175;
		cf_name_pos = /usr/local/share/haxe/std/haxe/EnumTools.hx: 3057-3070;
		cf_meta = [];
