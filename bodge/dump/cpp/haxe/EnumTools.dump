		cf_params = [{
			name = T;
			class = createByIndex.T;
			host = TPHMethod;
			type = TInst(createByIndex.T, []);
			constraints = [];
			default = None;
		}];
		cf_expr = [Function:(e : Enum<createByIndex.T>, index : Int, ?params : Null<Array<Dynamic>>) -> createByIndex.T]
			[Arg e<121>(VUsedByTyper):Enum<createByIndex.T>]
			[Arg index<122>(VUsedByTyper):Int]
			[Arg params<123>(VUsedByTyper):Null<Array<Dynamic>>] [Const:Null<Array<Dynamic>>] null
